<Window x:Class="Printly.DeveloperLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Printly"
        mc:Ignorable="d"
        Background="{StaticResource AppBackground}"
        Title="Printly" Height="338" Width="299"
            WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Resources/logo.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="DodgerBlue"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="CornflowerBlue"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DADADA"/>
        <Style x:Key="RoundedTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordTxtBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="6" Height="33">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Image HorizontalAlignment="Left" Height="98" Margin="112,47,0,0" VerticalAlignment="Top" Width="58" Source="/Resources/png/user.png"/>
        <Label Content="Вход като Developer" HorizontalAlignment="Left" Margin="79,100,0,0" VerticalAlignment="Top" FontWeight="Bold" Height="30" Width="152"/>
        <TextBox x:Name ="txtUsername" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Margin="60,130,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="171" Height="34" FontWeight="Bold"/>
        <Label HorizontalAlignment="Left" Margin="51,208,0,0" VerticalAlignment="Top" Height="12" Width="11"/>
        <PasswordBox  x:Name ="txtPassword" Style="{StaticResource PasswordTxtBoxStyle}" HorizontalAlignment="Left" Margin="60,172,0,0"  VerticalAlignment="Top" Width="171" Height="36" FontWeight="Bold" KeyDown="txtPassword_KeyDown"/>
        <Button x:Name="LoginButton"  Style="{StaticResource MainButtonStyle}" Content="Вход" HorizontalAlignment="Left" Margin="90,208,0,0" VerticalAlignment="Top" Width="102" Height="43" Click="LoginButton_Click"/>
        <Image HorizontalAlignment="Left" Height="52" Margin="34,134,0,0" VerticalAlignment="Top" Width="26" Source="pack://application:,,,/Resources/png/63699.png"/>
        <Image HorizontalAlignment="Left" Height="54" Margin="32,176,0,0" VerticalAlignment="Top" Width="28" Source="pack://application:,,,/Resources/png/login-page-password.png"/>
    </Grid>
</Window>
